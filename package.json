{
  "name": "@ninesols/aca-cli",
  "version": "0.3.0",
  "description": "通过阿里云云助手在 Windows ECS 上自动发布 IIS 站点和 Windows 服务，也能回退、执行 PowerShell、检查和更换 SSL 证书，附带 Agent Skill 供 Claude Code、Codex 等 AI Agent 调用",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "alibaba-cloud",
    "aliyun",
    "auto-deploy",
    "cli",
    "cloud-assistant",
    "deployment",
    "ecs",
    "iis",
    "powershell",
    "ssl-certificates",
    "windows-server"
  ],
  "author": "YoungsunLi",
  "license": "MIT",
  "repository": "github:YoungsunLi/aca",
  "type": "module",
  "bin": {
    "aca": "dist/cli.js"
  },
  "files": [
    "dist",
    "ps",
    ".claude/skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@alicloud/cas20200407": "^3.2.14",
    "@alicloud/credentials": "^2.4.7",
    "@alicloud/ecs20140526": "^7.11.1",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/slb20140515": "^2.0.12",
    "ali-oss": "^6.23.0",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "node-forge": "^1.4.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.4.1",
    "@types/node-forge": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
